              ],
              "body": "{\n  \"code\": \"FORBIDDEN\",\n  \"message\": \"forbidden\"\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "404 Not Found",
              "status": "Not Found",
              "code": 404,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"code\": \"user_NOT_FOUND\",\n  \"message\": \"user not found\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },
